# Shared PostgreSQL / Supabase Database Configuration (Streamlit & Vercel)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google OAuth Credentials (for Production deployment)
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"

# Multi-Provider AI Configuration
# Supported providers: gemini, openai, openrouter, groq, together, ollama, custom
AI_PROVIDER="gemini"
AI_API_KEY="YOUR_API_KEY_HERE"
AI_MODEL="gemini-2.5-flash"
# AI_BASE_URL is optional (used for Ollama or Custom OpenAI-compatible endpoints)
# AI_BASE_URL="http://localhost:11434/v1"

# Specific Provider Fallback Keys
# OPENAI_API_KEY="sk-..."
# GROQ_API_KEY="gsk_..."
# OPENROUTER_API_KEY="sk-or-..."

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

