# AI Studio default injected key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Multi-Provider AI Configuration
# Supported providers: gemini, openai, openrouter, groq, together, ollama, custom
AI_PROVIDER="gemini"
AI_API_KEY="YOUR_API_KEY_HERE"
AI_MODEL="gemini-2.5-flash"
# AI_BASE_URL is optional (used for Ollama or Custom OpenAI-compatible endpoints)
# AI_BASE_URL="http://localhost:11434/v1"

# Specific Provider Fallback Keys
# OPENAI_API_KEY="sk-..."
# GROQ_API_KEY="gsk_..."
# OPENROUTER_API_KEY="sk-or-..."

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

